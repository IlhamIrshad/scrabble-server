# Copy to .env for local runs. On Dokploy, set these in the Environment tab
# instead. Every field in app/config.py is overridable this way.

# --- registration ----------------------------------------------------------
DETECT_MAX_EDGE=1000
WARP_SIZE=720
# Leave at 0. The grid-lock pass works the inset out from the printed grid.
GRID_INSET_FRAC=0.0

# --- classification --------------------------------------------------------
# Reference glyphs are best taken from pictures of the tiles themselves - worth
# about ten points of word accuracy over a rendered font, because a font is not
# the shape of a tile and D/O, C/O and S/B differ only in shape.
#
# The container has no tile artwork on it, so build the bank where the images are
# and ship the file:
#
#   python scripts/build_templates.py templates/protiles.npz \
#       "C:/Program Files/NASPA Zyzzyva 3.4.2/data/tiles/white-pro"
#
# TEMPLATE_BANK=/app/templates/protiles.npz
#
# Or, if the images are on this machine, point at the folders directly instead:
# TEMPLATE_TILES=/app/tiles/white-pro
TEMPLATE_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
TEMPLATE_CACHE=/tmp/scrabble-templates.npz
# Cells below this confidence go into `low_confidence` for operator review. Left
# unset on purpose: the code default is calibrated against the confidence that
# measured misreads actually arrive with, and pinning a number here overrides that
# silently - it did, and a sweep of the value disagreed with the test suite for it.
# LOW_CONF_THRESHOLD=0.75

# --- blank tiles -----------------------------------------------------------
# A blank tile is told from bare board by colour alone, and both colours are
# measured from the photograph, so there is nothing board-specific to set here.
# Turn it off if your tiles and board are too close in colour to separate; the
# response says so in each cell's notes when that happens.
DETECT_BLANKS=true

# --- diagnostics -----------------------------------------------------------
DEBUG_DIR=/tmp/scrabble-debug
KEEP_DEBUG_IMAGES=50
