# Copy to .env for local runs. On Dokploy, set these in the Environment tab
# instead. Every field in app/config.py is overridable this way.

# --- registration ----------------------------------------------------------
DETECT_MAX_EDGE=1000
WARP_SIZE=720
# Leave at 0. The grid-lock pass works the inset out from the printed grid.
GRID_INSET_FRAC=0.0

# --- classification --------------------------------------------------------
TEMPLATE_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
TEMPLATE_CACHE=/tmp/scrabble-templates.npz
# Cells below this confidence go into `low_confidence` for operator review.
LOW_CONF_THRESHOLD=0.60

# --- blank tiles -----------------------------------------------------------
# Board- and tile-specific. Re-measure on your board, or turn it off.
DETECT_BLANKS=true
BLANK_MIN_SAT_DELTA=20.0

# --- diagnostics -----------------------------------------------------------
DEBUG_DIR=/tmp/scrabble-debug
KEEP_DEBUG_IMAGES=50
